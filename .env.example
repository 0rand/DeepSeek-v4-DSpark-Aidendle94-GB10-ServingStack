# =============================================================================
# DS4F-DSpark-Aiden — Single Configuration File
# =============================================================================
# Copy this file to .env, edit for your cluster, then:
#
#   WORKER (start FIRST):  docker compose --env-file .env -f compose.worker.yaml up -d
#   HEAD   (start second): docker compose --env-file .env -f compose.head.yaml  up -d
#
# Or use ./start.sh (handles sync + ordering).
#
# Values below are the PROVEN production tuning from a 2x DGX Spark cluster
# running DeepSeek-V4-Flash-0731 GA at 1M context. Only the site-specific
# values (marked EDIT) need changing.
# =============================================================================

# --- Docker Image ---
# reffix-0731 ships the official 0731 reasoning-effort encoder fix baked in.
# To build it yourself from base production-3.75, see Dockerfile + apply-encoder-patch.sh.
IMAGE=aidendle94/sparkrun-vllm-ds4-gb10:production-3.75-reffix-0731

# --- Model ---
# Official DeepSeek-V4-Flash-0731 GA. A local path works too: the parent
# directory of HF_CACHE is mounted at /root/.cache/huggingface in the container,
# so MODEL_PATH=/root/.cache/huggingface/DeepSeek-V4-Flash-0731 is the local form.
MODEL_PATH=deepseek-ai/DeepSeek-V4-Flash-0731
# Pin to a specific revision to avoid cache surprises when DeepSeek pushes
# a README-only update that invalidates the HF cache.
MODEL_REVISION=7872f01b1d1fe23eabc4c98b48bffcef5a386062

# The served model name your clients use (keep stable across config changes).
SERVED_MODEL_NAME=deepseek-v4-flash

# --- Cache Directories ---
# Absolute paths on each node. These are local paths — both nodes can use
# the same value if the directory structure is identical.
HF_CACHE=/home/user/models/deepseek-ai
VLLM_CACHE=/home/user/.cache/vllm-ds4-0731-aiden
TILELANG_CACHE=/home/user/.cache/tilelang-ds4-0731-aiden

# --- RoCE Network Interfaces ---  [EDIT]
# Find yours:
#   ibstat | grep -E 'CA|hca_id'          → HCA names
#   ip -br addr | grep <roce-subnet>      → netdev names
# Both DGX Sparks use identical CX7 NICs so these values are the same
# on both nodes if your hardware is homogenous.
NCCL_IB_HCA=rocepXsXfX,rocePXpXfX
NCCL_SOCKET_IFNAME=enpXsXfXnpX
CONTROL_IF=enpXsXfXnpX

# --- Cluster IPs (RoCE / backend network) ---  [EDIT]
MASTER_ADDR=192.168.0.1       # head node's RoCE IP — same on both nodes
HEAD_ROCE_IP=192.168.0.1      # head node's own RoCE IP (usually same as MASTER_ADDR)
WORKER_ROCE_IP=192.168.0.2    # worker node's own RoCE IP

# --- SSH (for start.sh to sync configs to the worker) ---  [EDIT]
WORKER_SSH_TARGET=user@worker-hostname-or-ip
WORKER_DIR=/home/user/dockers/DS4F-0731-Aiden-3.75

# --- Serving ---
PORT=8100
TP_SIZE=2                     # tensor parallelism across 2 nodes
SPEC_TOKENS=5                 # DSpark speculative tokens (greedy draft)

# --- Generation Defaults (proven production tuning) ---
TEMPERATURE=0.8
TOP_P=0.25
REPETITION_PENALTY=1.0

# --- GPU Memory ---
GPU_MEMORY_UTILIZATION=0.84

# --- Context & Throughput ---
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384
GRAPH_CAP=512
ASYNC_SCHED=1

# --- CPU (optional) ---
OMP_NUM_THREADS=4
